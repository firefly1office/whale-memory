{
  "about": "召回用例。type：exact=用了原文里的词；paraphrase=换个说法；combo=几个线索拼起来；none=根本没有这件事；near=沾边但没有这件事（最容易诱导编造）。expect 是应该排第一的经历 id，none/near 应该返回空。",
  "recall": [
    { "type": "exact", "query": "海上灯塔", "expect": ["e01", "e04", "e13"] },
    { "type": "exact", "query": "番茄炒蛋", "expect": ["e06", "e24"] },
    { "type": "exact", "query": "菲涅耳透镜", "expect": ["e08"] },
    { "type": "exact", "query": "收音机", "expect": ["e10", "e17", "e28"] },
    { "type": "exact", "query": "桂花树", "expect": ["e16"] },
    { "type": "exact", "query": "纸鹤", "expect": ["e21"] },
    { "type": "exact", "query": "深海鱼", "expect": ["e19", "e26"] },
    { "type": "exact", "query": "日落", "expect": ["e23"] },
    { "type": "exact", "query": "路灯", "expect": ["e30"] },
    { "type": "exact", "query": "面包店", "expect": ["e18"] },
    { "type": "exact", "query": "毛笔", "expect": ["e03"] },
    { "type": "exact", "query": "围巾", "expect": ["e28"] },
    { "type": "paraphrase", "query": "守灯人修透镜那段", "expect": ["e04"] },
    { "type": "paraphrase", "query": "那次做菜盐放多了", "expect": ["e06"] },
    { "type": "paraphrase", "query": "和阿禾吵架", "expect": ["e11"] },
    { "type": "paraphrase", "query": "跟阿禾道歉了吗", "expect": ["e20"] },
    { "type": "paraphrase", "query": "下雨天没带伞的事", "expect": ["e12"] },
    { "type": "paraphrase", "query": "外婆家门口的树", "expect": ["e16"] },
    { "type": "paraphrase", "query": "坐公交坐过站", "expect": ["e18"] },
    { "type": "paraphrase", "query": "会发光的鱼", "expect": ["e19"] },
    { "type": "paraphrase", "query": "鮟鱇鱼的小灯", "expect": ["e26"] },
    { "type": "paraphrase", "query": "楼顶看太阳下山", "expect": ["e23"] },
    { "type": "paraphrase", "query": "看雨的那篇博客", "expect": ["e02", "e09"] },
    { "type": "paraphrase", "query": "失眠数灯", "expect": ["e30"] },
    { "type": "combo", "query": "灯塔 钥匙 接班人", "expect": ["e13"] },
    { "type": "combo", "query": "收音机 电容 修好", "expect": ["e17", "e10"] },
    { "type": "combo", "query": "番茄 糖", "expect": ["e24"] },
    { "type": "combo", "query": "小说 重写 结尾", "expect": ["e22"] },
    { "type": "combo", "query": "老歌 织围巾", "expect": ["e28"] },
    { "type": "combo", "query": "云 橘色 灰紫", "expect": ["e05"] },
