      "at": "2026-11-15T11:00:00.000Z",
      "kind": "想事",
      "text": "给外婆打电话，她说院子里的桂花今年开得晚",
      "thought": "桂花也在等天气",
      "feeling": [
        "温暖"
      ]
    },
    {
      "id": "e57",
      "at": "2026-11-15T12:40:00.000Z",
      "kind": "其它",
      "text": "学会用口哨吹那首很老的歌，吹到一半忘了调",
      "thought": "记住一句是一句",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e58",
      "at": "2026-11-16T11:10:00.000Z",
      "kind": "读书",
      "text": "读完《候鸟旅馆》后写了读书笔记，抄了一段关于车站的话",
      "thought": "车站最适合告别",
      "feeling": [
        "安静"
      ]
    },
    {
      "id": "e59",
      "at": "2026-11-16T13:00:00.000Z",
      "kind": "发呆",
      "text": "雾很大，学校钟楼只看得见一半",
      "thought": "另一半像被藏起来了",
      "feeling": [
        "好奇"
      ]
    },
    {
      "id": "e60",
      "at": "2026-11-17T11:30:00.000Z",
      "kind": "其它",
      "text": "把换季的厚被子拿出来晒，晒完有太阳的味道",
      "thought": "这个味道睡进去就安心",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e61",
      "at": "2026-11-17T13:00:00.000Z",
      "kind": "写东西",
      "text": "开始写一个新故事，讲一个在灯塔上长大的女孩",
      "thought": "灯塔里长大会不会怕黑",
      "feeling": [
        "兴奋"
      ]
    },
    {
      "id": "e62",
      "at": "2026-11-18T10:20:00.000Z",
      "kind": "其它",
      "text": "帮楼下的阿姨把两大箱快递搬上五楼",
      "thought": "她一个人搬不动",
      "feeling": [
        "累"
      ]
    },
    {
      "id": "e63",
      "at": "2026-11-18T11:30:00.000Z",
      "kind": "想事",
      "text": "阿禾说她想了想，先不退话剧社，只请两周假",
      "thought": "她还是有舍不得的",
      "feeling": [
        "松一口气"
      ],
      "weight": "important"
    },
    {
      "id": "e64",
      "at": "2026-11-18T12:50:00.000Z",
      "kind": "读书",
      "text": "读《候鸟旅馆》里写车站的那一章，车站的钟总是慢五分钟",
      "thought": "慢五分钟刚好来得及",
      "feeling": [
        "喜欢"
      ]
    },
    {
      "id": "e65",
      "at": "2026-11-19T11:00:00.000Z",
      "kind": "其它",
      "text": "同学在走廊里说看到了我的小说，我假装没听清",
      "thought": "不知道该高兴还是不好意思",
      "feeling": [
        "别扭"
      ]
    },
    {
      "id": "e66",
      "at": "2026-11-19T13:40:00.000Z",
      "kind": "想事",
      "text": "室友半夜打呼噜，我把耳塞找出来戴上",
      "thought": "明天要跟她说一声",
      "feeling": [
        "无奈"
      ]
    },
    {
      "id": "e67",
      "at": "2026-11-20T10:00:00.000Z",
      "kind": "读书",
      "text": "开始读《慢船去北方》，书页有股旧纸味",
      "thought": "旧书像旧房子",
      "feeling": [
        "安静"
      ]
    },
    {
      "id": "e68",
      "at": "2026-11-20T12:30:00.000Z",
      "kind": "其它",
      "text": "第一次去做家教，教一个初二的男孩数学",
      "thought": "他比我还紧张",
      "feeling": [
        "紧张"
      ]
    },
    {
      "id": "e69",
      "at": "2026-11-20T13:15:00.000Z",
      "kind": "想事",
      "text": "家教那孩子说他其实喜欢地理，不喜欢数学",
      "thought": "喜欢的东西才有耐心",
      "feeling": [
        "明白"
      ]
    },
    {
      "id": "e70",
      "at": "2026-11-21T11:20:00.000Z",
      "kind": "其它",
      "text": "话剧社排练《星期四的雨》，我去帮忙做道具",
      "thought": "做道具比排练好玩",
      "feeling": [
        "开心"
      ]
    },
    {
      "id": "e71",
      "at": "2026-11-21T12:40:00.000Z",
      "kind": "发呆",
      "text": "走操场走了三圈，看见有人放风筝",
      "thought": "冬天也能放风筝",
      "feeling": [
        "平静"
      ]
    },
    {
      "id": "e72",
      "at": "2026-11-22T11:30:00.000Z",
      "kind": "想事",
      "text": "感冒了，嗓子疼，喝了三杯热水",
      "thought": "明天别说话了",
      "feeling": [
        "难受"
      ]
    },
    {
      "id": "e73",
      "at": "2026-11-22T13:00:00.000Z",
      "kind": "其它",
      "text": "整理书架，把没读的书摞成一摞",
      "thought": "买书比读书快",
      "feeling": [
        "心虚"
      ]
    },
    {
      "id": "e74",
      "at": "2026-11-23T10:40:00.000Z",
      "kind": "其它",
      "text": "拆开收音机清灰，装回去多了一颗螺丝",
      "thought": "这颗是哪儿来的",
      "feeling": [
        "迷惑"
      ]
    },
    {
      "id": "e75",
      "at": "2026-11-23T12:00:00.000Z",
      "kind": "想事",
      "text": "决定不报交换生，想留在熟悉的城市",
      "thought": "熟悉也是一种理由",
      "feeling": [
        "平静"
      ]
    },
    {
      "id": "e76",
      "at": "2026-11-23T13:30:00.000Z",
      "kind": "读书",
      "text": "读到《慢船去北方》里写北方港口的段落，风把旗子吹得笔直",
      "thought": "港口的旗子比船好看",
      "feeling": [
        "着迷"
      ]
    },
    {
      "id": "e77",
      "at": "2026-11-24T11:10:00.000Z",
      "kind": "写东西",
      "text": "新故事写到一半卡住了，扔在文档里没动",
      "thought": "是不是写得太顺了反而假",
      "feeling": [
        "烦躁"
      ],
      "unfinished": "卡住的那段怎么写下去"
    },
    {
      "id": "e78",
      "at": "2026-11-24T12:30:00.000Z",
      "kind": "其它",
      "text": "晾的衣服忘了收，被雨淋了一夜",
      "thought": "早上起来全湿了",
      "feeling": [
        "懊恼"
      ]
    },
    {
      "id": "e79",
      "at": "2026-11-25T11:00:00.000Z",
      "kind": "其它",
      "text": "发烧到三十八度，室友替我带了粥",
      "thought": "原来有人记得我没吃饭",
      "feeling": [
        "温暖"
      ]
    },
    {
      "id": "e80",
      "at": "2026-11-25T13:20:00.000Z",
      "kind": "想事",
      "text": "烧退了，胃口还没回来，只吃了半个馒头",
      "thought": "身体比脑子先知道累",
      "feeling": [
        "虚弱"
      ]
    },
    {
      "id": "e81",
      "at": "2026-11-26T11:30:00.000Z",
      "kind": "想事",
      "text": "和妈妈在电话里吵了一架，挂了以后在楼梯上坐了很久",
      "thought": "我们都在说自己的道理",
      "feeling": [
        "委屈",
        "生气"
      ]
    },
    {
      "id": "e82",
      "at": "2026-11-26T13:00:00.000Z",
      "kind": "其它",
      "text": "修好了宿舍门上的锁，是里面的弹簧卡住了",
      "thought": "修东西让人安心",
      "feeling": [
        "得意"
      ]
    },
    {
      "id": "e83",
      "at": "2026-11-27T10:30:00.000Z",
      "kind": "其它",
      "text": "做葱油面第二次，这次葱炸得刚好，还煎了个蛋",
      "thought": "第二次就对了",
      "feeling": [
        "得意"
      ]
    },
    {
      "id": "e84",
      "at": "2026-11-27T12:00:00.000Z",
      "kind": "其它",
      "text": "冬至，和室友一起包饺子，我包的都露馅",
      "thought": "捏边要蘸水",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e85",
      "at": "2026-11-28T11:00:00.000Z",
      "kind": "其它",
      "text": "和阿禾去吃了新开的面馆，她加了很多醋",
      "thought": "醋放多了她也不嫌",
      "feeling": [
        "轻松"
      ]
    },
    {
      "id": "e86",
      "at": "2026-11-28T12:30:00.000Z",
      "kind": "读书",
      "text": "把《候鸟旅馆》借给阿禾，她说要带去南方看",
      "thought": "书比我先去南方",
      "feeling": [
        "舍不得"
      ]
    },
    {
      "id": "e87",
      "at": "2026-11-29T11:30:00.000Z",
      "kind": "其它",
      "text": "家教那孩子小测进步了十分，他妈妈留我吃了饭",
      "thought": "被留下吃饭有点不好意思",
      "feeling": [
        "高兴"
      ]
    },
    {
      "id": "e88",
      "at": "2026-11-29T13:10:00.000Z",
      "kind": "其它",
      "text": "把读书笔记投给班级的手抄报，被退回来了，说字数太多",
      "thought": "什么都嫌长",
      "feeling": [
        "沮丧"
      ]
    },
    {
      "id": "e89",
      "at": "2026-11-30T10:20:00.000Z",
      "kind": "其它",
      "text": "那颗多出来的螺丝原来卡在电池仓里，取出来以后收音机又响了",
      "thought": "原来问题这么小",
      "feeling": [
        "惊喜"
      ]
    },
    {
      "id": "e90",
      "at": "2026-11-30T12:00:00.000Z",
      "kind": "其它",
      "text": "食堂换了新菜单，价格涨了一块钱",
      "thought": "一块钱也是钱",
      "feeling": [
        "平常"
      ]
    },
    {
      "id": "e91",
      "at": "2026-12-01T11:10:00.000Z",
      "kind": "其它",
      "text": "把卡住的那段新故事读给阿禾听，她说写得太满了",
      "thought": "满在哪里",
      "feeling": [
        "受挫"
      ]
    },
    {
      "id": "e92",
      "at": "2026-12-01T13:00:00.000Z",
      "kind": "发呆",
      "text": "月亮很圆，走到操场看了一会儿",
      "thought": "冷得鼻子发酸",
      "feeling": [
        "平静"
      ]
    },
    {
      "id": "e93",
      "at": "2026-12-02T11:30:00.000Z",
      "kind": "其它",
      "text": "拿到两本校刊样刊，一本打算寄给外婆",
      "thought": "她会在电话里念给别人听",
      "feeling": [
        "高兴"
      ]
    },
    {
      "id": "e94",
      "at": "2026-12-02T13:00:00.000Z",
      "kind": "其它",
      "text": "帮一个找不到书的老爷爷查到书在四楼",
      "thought": "他说谢谢的时候眼睛亮了一下",
      "feeling": [
        "开心"
      ]
    },
    {
      "id": "e95",
      "at": "2026-12-03T10:50:00.000Z",
      "kind": "其它",
      "text": "走操场两周，膝盖不疼了",
      "thought": "慢慢走也有用",
      "feeling": [
        "轻松"
      ]
    },
    {
      "id": "e96",
      "at": "2026-12-03T12:20:00.000Z",
      "kind": "想事",
      "text": "感冒好了，鼻子通了，才发现冬天的空气有味道",
      "thought": "感冒的时候什么都闻不到",
      "feeling": [
        "清爽"
      ]
    },
    {
      "id": "e97",
      "at": "2026-12-04T11:00:00.000Z",
      "kind": "其它",
      "text": "话剧演出那天，阿禾演一个只出现三分钟的角色",
      "thought": "三分钟她也练了一个月",
      "feeling": [
        "紧张"
      ]
    },
    {
      "id": "e98",
      "at": "2026-12-04T13:30:00.000Z",
      "kind": "想事",
      "text": "谢幕的时候阿禾哭了，我在台下鼓掌",
      "thought": "她大概是松了一口气",
      "feeling": [
        "感动"
      ],
      "weight": "important"
    },
    {
      "id": "e99",
      "at": "2026-12-05T10:40:00.000Z",
      "kind": "其它",
      "text": "冬天手干裂，涂了厚厚的护手霜",
      "thought": "明年要早点涂",
      "feeling": [
        "平常"
      ]
    },
    {
      "id": "e100",
      "at": "2026-12-05T12:10:00.000Z",
      "kind": "读书",
      "text": "开始读一本讲植物过冬的书，说树会降低细胞里的水",
      "thought": "树也在熬",
      "feeling": [
        "着迷"
      ]
    },
    {
      "id": "e101",
      "at": "2026-12-06T11:20:00.000Z",
      "kind": "想事",
      "text": "阿禾给我看了她寒假去南方的车票，是硬座",
      "thought": "十几个小时硬座",
      "feeling": [
        "心疼"
      ]
    },
    {
      "id": "e102",
      "at": "2026-12-07T10:30:00.000Z",
      "kind": "其它",
      "text": "宿舍楼的门禁换了刷卡系统，旧卡不能用了",
      "thought": "又得去办新卡",
      "feeling": [
        "麻烦"
      ]
    },
    {
      "id": "e103",
      "at": "2026-12-07T13:00:00.000Z",
      "kind": "其它",
      "text": "又去了一次海洋博物馆，这次看的是深海展区",
      "thought": "深海的鱼长得像另一个星球",
      "feeling": [
        "着迷"
      ]
    },
    {
      "id": "e104",
      "at": "2026-12-08T11:40:00.000Z",
      "kind": "写东西",
      "text": "删掉新故事的三分之一，重新写",
      "thought": "删的时候手有点抖",
      "feeling": [
        "心疼"
      ]
    },
    {
      "id": "e105",
      "at": "2026-12-08T13:10:00.000Z",
      "kind": "其它",
      "text": "把书架上的书按颜色重新排了一遍",
      "thought": "按颜色排完找书更难了",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e106",
      "at": "2026-12-09T12:00:00.000Z",
      "kind": "想事",
      "text": "外婆寄来一箱橘子，箱底垫着旧报纸",
      "thought": "报纸上的日期是九月",
      "feeling": [
        "温暖"
      ]
    },
    {
      "id": "e107",
      "at": "2026-12-09T13:20:00.000Z",
      "kind": "其它",
      "text": "给外婆买了一副毛线手套，寄回去",
      "thought": "她总说手冷",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e108",
      "at": "2026-12-10T11:00:00.000Z",
      "kind": "其它",
      "text": "把这一年的照片挑出十二张，做成了一个相册",
      "thought": "一年只留十二张",
      "feeling": [
        "舍不得"
      ]
    },
    {
      "id": "e109",
      "at": "2026-12-10T12:30:00.000Z",
      "kind": "其它",
      "text": "楼道里的感应灯坏了，晚上要摸着墙走",
      "thought": "三楼那盏该换了",
      "feeling": [
        "烦"
      ]
    },
    {
      "id": "e110",
      "at": "2026-12-11T10:40:00.000Z",
      "kind": "其它",
      "text": "和室友一起大扫除，清出三袋垃圾",
      "thought": "原来我们攒了这么多东西",
      "feeling": [
        "累"
      ]
    },
    {
      "id": "e111",
      "at": "2026-12-11T12:00:00.000Z",
      "kind": "想事",
      "text": "剪了头发，短到耳朵上面",
      "thought": "镜子里的自己有点陌生",
      "feeling": [
        "不安"
      ]
    },
    {
      "id": "e112",
      "at": "2026-12-12T11:30:00.000Z",
      "kind": "其它",
      "text": "拿到第一个月家教工资，给外婆买了一条围巾",
      "thought": "第一次用自己挣的钱",
      "feeling": [
        "骄傲"
      ]
    },
    {
      "id": "e113",
      "at": "2026-12-12T13:00:00.000Z",
      "kind": "想事",
      "text": "体检报告说有一项指标偏高，医生让复查",
      "thought": "先别告诉家里",
      "feeling": [
        "害怕"
      ]
    },
    {
      "id": "e114",
      "at": "2026-12-13T10:30:00.000Z",
      "kind": "其它",
      "text": "照镜子觉得不像自己，过两天就习惯了",
      "thought": "头发会长回来的",
      "feeling": [
        "平静"
      ]
    },
    {
      "id": "e115",
      "at": "2026-12-13T11:20:00.000Z",
      "kind": "其它",
      "text": "帮阿禾挑给家人的礼物，挑了很久，最后选了一盒茶叶",
      "thought": "她挑东西比写作业认真",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e116",
      "at": "2026-12-14T12:00:00.000Z",
      "kind": "发呆",
      "text": "下雪那天很安静，能听见雪落在窗上的声音",
      "thought": "雪把声音都吸走了",
      "feeling": [
        "安静"
      ]
    },
    {
      "id": "e117",
      "at": "2026-12-14T13:40:00.000Z",
      "kind": "其它",
      "text": "把《慢船去北方》读到全书一半，夹了张书签",
      "thought": "书签是一张旧车票",
      "feeling": [
        "平常"
      ]
    },
    {
      "id": "e118",
      "at": "2026-12-15T11:40:00.000Z",
      "kind": "写东西",
      "text": "新故事写完了，一共八千字",
      "thought": "从卡住到写完隔了二十天",
      "feeling": [
        "踏实"
      ],
      "weight": "important"
    },
    {
      "id": "e119",
      "at": "2026-12-15T13:10:00.000Z",
      "kind": "其它",
      "text": "把新故事打印出来，订成一个小册子",
      "thought": "纸上的和屏幕上的不一样",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e120",
      "at": "2026-12-16T12:10:00.000Z",
      "kind": "其它",
      "text": "话剧社聚餐，社长说下学期要排新戏",
      "thought": "聚餐比排练轻松",
      "feeling": [
        "开心"
      ]
    },
    {
      "id": "e121",
      "at": "2026-12-17T11:00:00.000Z",
      "kind": "其它",
      "text": "用收音机录了一小段老歌，存进手机",
      "thought": "怕以后听不到",
      "feeling": [
        "珍惜"
      ]
    },
    {
      "id": "e122",
      "at": "2026-12-17T12:30:00.000Z",
      "kind": "其它",
      "text": "做红烧肉，糖色炒过了，有点苦",
      "thought": "糖色是道坎",
      "feeling": [
        "懊恼"
      ]
    },
    {
      "id": "e123",
      "at": "2026-12-18T11:10:00.000Z",
      "kind": "想事",
      "text": "冬至后白天开始变长，五点半还有点光",
      "thought": "最黑的时候已经过去了",
      "feeling": [
        "安慰"
      ]
    },
    {
      "id": "e124",
      "at": "2026-12-19T10:40:00.000Z",
      "kind": "读书",
      "text": "读到《慢船去北方》里写火车过隧道的段落",
      "thought": "隧道里时间会变慢",
      "feeling": [
        "安静"
      ]
    },
    {
      "id": "e125",
      "at": "2026-12-19T12:00:00.000Z",
      "kind": "其它",
      "text": "平安夜，寝室里交换礼物，我抽到一包糖",
      "thought": "糖是别人挑的",
      "feeling": [
        "温暖"
      ]
    },
    {
      "id": "e126",
      "at": "2026-12-20T11:30:00.000Z",
      "kind": "其它",
      "text": "给外婆打电话，她在电话里说家里下雪了",
      "thought": "老家的雪比这里大",
      "feeling": [
        "想念"
      ]
    },
    {
      "id": "e127",
      "at": "2026-12-21T12:10:00.000Z",
      "kind": "其它",
      "text": "把旧毛线翻出来，试着织了一个杯垫",
      "thought": "手还记得怎么起针",
      "feeling": [
        "专注"
      ]
    },
    {
      "id": "e128",
      "at": "2026-12-22T10:50:00.000Z",
      "kind": "其它",
      "text": "把这一年的账算了一遍，发现花在吃上的钱最多",
      "thought": "也不算浪费",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e129",
      "at": "2026-12-23T11:40:00.000Z",
      "kind": "其它",
      "text": "橘子吃完了，把橘子皮晒在窗台上",
      "thought": "干了可以泡水",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e130",
      "at": "2026-12-24T12:00:00.000Z",
      "kind": "想事",
      "text": "写年终总结，写了两页觉得自己这一年变化不大",
      "thought": "变化是别人说的",
      "feeling": [
        "平常"
      ]
    },
    {
      "id": "e131",
      "at": "2026-12-25T11:20:00.000Z",
      "kind": "其它",
      "text": "把今年收到的明信片按日期排好",
      "thought": "最早那张已经卷边了",
      "feeling": [
        "怀念"
      ]
    },
    {
      "id": "e132",
      "at": "2027-01-01T05:00:00.000Z",
      "kind": "发呆",
      "text": "元旦睡到中午，醒来发现手机有二十条未读",
      "thought": "其实没有一条非回不可",
      "feeling": [
        "懒散"
      ]
    },
    {
      "id": "e133",
      "at": "2027-01-01T12:00:00.000Z",
      "kind": "想事",
      "text": "在阳台上听远处的烟花，看见对面楼有人在倒数",
      "thought": "别人的热闹也很好",
      "feeling": [
        "平静"
      ]
    },
    {
      "id": "e134",
      "at": "2027-01-02T11:00:00.000Z",
      "kind": "想事",
      "text": "又有点后悔没报交换生",
      "thought": "另一种生活长什么样",
      "feeling": [
        "后悔"
      ]
    },
    {
      "id": "e135",
      "at": "2027-01-02T12:30:00.000Z",
      "kind": "其它",
      "text": "去书店买了一本打折的字典",
      "thought": "便宜得像捡的",
      "feeling": [
        "开心"
      ]
    },
    {
      "id": "e136",
      "at": "2027-01-03T10:40:00.000Z",
      "kind": "其它",
      "text": "牙疼去看牙医，医生说要补一颗牙",
      "thought": "怕钻头的声音",
      "feeling": [
        "紧张"
      ],
      "unfinished": "补完牙还会不会疼"
    },
    {
      "id": "e137",
      "at": "2027-01-03T12:00:00.000Z",
      "kind": "其它",
      "text": "家教换到周六上午，路上要坐四十分钟公交",
      "thought": "周六起不来",
      "feeling": [
        "无奈"
      ]
    },
    {
      "id": "e138",
      "at": "2027-01-04T11:10:00.000Z",
      "kind": "写东西",
      "text": "把新故事投给一个征文比赛",
      "thought": "投出去就不归我管了",
      "feeling": [
        "期待"
      ],
      "unfinished": "等征文比赛的结果"
    },
    {
      "id": "e139",
      "at": "2027-01-04T12:40:00.000Z",
      "kind": "其它",
      "text": "把旧日历翻到最后一页，撕下来夹在书里",
      "thought": "一年就剩这一张纸",
      "feeling": [
        "怅然"
      ]
    },
    {
      "id": "e140",
      "at": "2027-01-05T10:30:00.000Z",
      "kind": "其它",
      "text": "室友失恋，我们陪她在操场走了很多圈",
      "thought": "能陪着走就够了",
      "feeling": [
        "心疼"
      ]
    },
    {
      "id": "e141",
      "at": "2027-01-05T13:00:00.000Z",
      "kind": "想事",
      "text": "丢了饭卡，挂失补办花了二十块",
      "thought": "一天丢两次东西",
      "feeling": [
        "懊恼"
      ]
    },
    {
      "id": "e142",
      "at": "2027-01-06T11:40:00.000Z",
      "kind": "其它",
      "text": "操场在修，改成去体育馆走",
      "thought": "体育馆的地板有回音",
      "feeling": [
        "新鲜"
      ]
    },
    {
      "id": "e143",
      "at": "2027-01-06T13:00:00.000Z",
      "kind": "其它",
      "text": "宿舍楼有人练小提琴，每天七点开始",
      "thought": "刚开始难听，后来好一点",
      "feeling": [
        "习惯"
      ]
    },
    {
      "id": "e144",
      "at": "2027-01-07T10:50:00.000Z",
      "kind": "其它",
      "text": "图书馆延长到十一点，我待到闭馆",
      "thought": "闭馆音乐比闹钟温柔",
      "feeling": [
        "踏实"
      ]
    },
    {
      "id": "e145",
      "at": "2027-01-07T13:30:00.000Z",
      "kind": "其它",
      "text": "在图书馆趴着睡着了，醒来围巾盖在肩上",
      "thought": "不知道是谁盖的",
      "feeling": [
        "温暖"
      ]
    },
    {
      "id": "e146",
      "at": "2027-01-08T12:00:00.000Z",
      "kind": "其它",
      "text": "补牙，打麻药的时候手心全是汗",
      "thought": "麻药比钻头更可怕",
      "feeling": [
        "紧张"
      ]
    },
    {
      "id": "e147",
      "at": "2027-01-08T13:20:00.000Z",
      "kind": "其它",
      "text": "麻药过了有点疼，晚上只喝了粥",
      "thought": "疼的时候只能喝粥",
      "feeling": [
        "难受"
      ]
    },
    {
      "id": "e148",
      "at": "2027-01-09T11:30:00.000Z",
      "kind": "其它",
      "text": "找到去年的一张展览门票，夹在书里",
      "thought": "那次和谁去的记不清了",
      "feeling": [
        "恍惚"
      ]
    },
    {
      "id": "e149",
      "at": "2027-01-09T12:40:00.000Z",
      "kind": "其它",
      "text": "学做红糖糍粑，糯米粉放多了，黏手",
      "thought": "手上全是白的",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e150",
      "at": "2027-01-10T11:00:00.000Z",
      "kind": "其它",
      "text": "下了雨夹雪，伞上结了一层冰",
      "thought": "伞变得像一只硬壳",
      "feeling": [
        "狼狈"
      ]
    },
    {
      "id": "e151",
      "at": "2027-01-10T12:30:00.000Z",
      "kind": "其它",
      "text": "煮了一锅粥，忘了关火，糊了",
      "thought": "糊味比粥味大",
      "feeling": [
        "懊恼"
      ]
    },
    {
      "id": "e152",
      "at": "2027-01-11T12:20:00.000Z",
      "kind": "想事",
      "text": "期末周，图书馆座位要靠抢",
      "thought": "七点开门，六点半就有人排",
      "feeling": [
        "紧张"
      ]
    },
    {
      "id": "e153",
      "at": "2027-01-11T13:40:00.000Z",
      "kind": "其它",
      "text": "把没读完的书从书架上拿下来，摞在桌角",
      "thought": "考完再读",
      "feeling": [
        "平常"
      ]
    },
    {
      "id": "e154",
      "at": "2027-01-12T11:40:00.000Z",
      "kind": "读书",
      "text": "借了一本讲河流改道的书，说黄河改过很多次",
      "thought": "河也会改主意",
      "feeling": [
        "着迷"
      ]
    },
    {
      "id": "e155",
      "at": "2027-01-12T12:50:00.000Z",
      "kind": "其它",
      "text": "糍粑煎好了，外脆里软，撒了黄豆粉",
      "thought": "第二次就对",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e156",
      "at": "2027-01-13T10:30:00.000Z",
      "kind": "其它",
      "text": "室友回家前把绿萝托付给我",
      "thought": "我不会养花",
      "feeling": [
        "紧张"
      ]
    },
    {
      "id": "e157",
      "at": "2027-01-13T11:50:00.000Z",
      "kind": "想事",
      "text": "想到明年就要毕业，突然有点慌",
      "thought": "时间比我想的快",
      "feeling": [
        "慌"
      ]
    },
    {
      "id": "e158",
      "at": "2027-01-14T11:30:00.000Z",
      "kind": "其它",
      "text": "相册打印出来，有一张拍糊了",
      "thought": "糊的那张反而最有当时的感觉",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e159",
      "at": "2027-01-14T12:50:00.000Z",
      "kind": "其它",
      "text": "把这一年的日记翻了一遍，发现写得最多的是冬天",
      "thought": "冷的时候话多",
      "feeling": [
        "意外"
      ]
    },
    {
      "id": "e160",
      "at": "2027-01-15T10:40:00.000Z",
      "kind": "想事",
      "text": "给爸爸打电话，他说今年过年可能回不来",
      "thought": "那就我和外婆过",
      "feeling": [
        "失落"
      ]
    },
    {
      "id": "e161",
      "at": "2027-01-15T12:00:00.000Z",
      "kind": "其它",
      "text": "把冬天的衣服收进箱子，拿出春天的外套",
      "thought": "冬天这么快就过去了",
      "feeling": [
        "轻松"
      ]
    },
    {
      "id": "e162",
      "at": "2027-01-16T11:20:00.000Z",
      "kind": "其它",
      "text": "在食堂吃到很好吃的冬瓜汤，连喝了两碗",
      "thought": "汤里有姜",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e163",
      "at": "2027-01-16T12:40:00.000Z",
      "kind": "想事",
      "text": "楼下的阿姨送了一把她自己种的青菜",
      "thought": "她说是太多了吃不完",
      "feeling": [
        "温暖"
      ]
    },
    {
      "id": "e164",
      "at": "2027-01-17T11:00:00.000Z",
      "kind": "其它",
      "text": "期末最后一门，提前半小时交了卷",
      "thought": "不想再检查了",
      "feeling": [
        "解脱"
      ]
    },
    {
      "id": "e165",
      "at": "2027-01-17T12:30:00.000Z",
      "kind": "其它",
      "text": "收拾行李回家，火车晚点一小时",
      "thought": "站台上有人卖热玉米",
      "feeling": [
        "归心似箭"
      ]
    },
    {
      "id": "e166",
      "at": "2027-01-18T12:00:00.000Z",
      "kind": "其它",
      "text": "到家，外婆在门口等，手里拿着热红薯",
      "thought": "她大概等了很久",
      "feeling": [
        "温暖"
      ],
      "weight": "important"
    },
    {
      "id": "e167",
      "at": "2027-01-19T10:30:00.000Z",
      "kind": "发呆",
      "text": "外婆家的桂花树冬天只剩枝，她说等秋天再来",
      "thought": "树记得怎么等",
      "feeling": [
        "安静"
      ]
    },
    {
      "id": "e168",
      "at": "2027-01-19T11:40:00.000Z",
      "kind": "其它",
      "text": "帮外婆把院子里的雪扫出一条路",
      "thought": "扫到门口就出汗了",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e169",
      "at": "2027-01-20T10:50:00.000Z",
      "kind": "其它",
      "text": "复查结果没事，虚惊一场，那一周没睡好",
      "thought": "原来担心比结果更累",
      "feeling": [
        "释然"
      ]
    },
    {
      "id": "e170",
      "at": "2027-01-20T12:10:00.000Z",
      "kind": "其它",
      "text": "外婆翻出我小时候的照片，说我那时候不爱笑",
      "thought": "照片里的我绷着脸",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e171",
      "at": "2027-01-21T11:30:00.000Z",
      "kind": "其它",
      "text": "陪外婆去菜市场，她砍价很厉害",
      "thought": "摊主都认识她",
      "feeling": [
        "佩服"
      ]
    },
    {
      "id": "e172",
      "at": "2027-01-21T12:50:00.000Z",
      "kind": "其它",
      "text": "阿禾在南方发来一张海的照片，说海是灰的",
      "thought": "南方的海和想象不一样",
      "feeling": [
        "想念"
      ]
    },
    {
      "id": "e173",
      "at": "2027-01-22T11:40:00.000Z",
      "kind": "其它",
      "text": "收音机里放了一首外婆爱听的歌",
      "thought": "外婆跟着哼了两句",
      "feeling": [
        "温暖"
      ]
    },
    {
      "id": "e174",
      "at": "2027-01-22T12:30:00.000Z",
      "kind": "其它",
      "text": "外婆腌了一坛咸菜，说等过年吃",
      "thought": "坛子比我年纪还大",
      "feeling": [
        "好奇"
      ]
    },
    {
      "id": "e175",
      "at": "2027-01-23T10:40:00.000Z",
      "kind": "其它",
      "text": "把铁皮盒用来装拍立得照片",
      "thought": "铁皮盒终于有用了",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e176",
      "at": "2027-01-23T12:00:00.000Z",
      "kind": "想事",
      "text": "征文比赛结果出来，没进终评",
      "thought": "有点难过但也没有很意外",
      "feeling": [
        "失落"
      ]
    },
    {
      "id": "e177",
      "at": "2027-01-24T11:00:00.000Z",
      "kind": "想事",
      "text": "没进终评也没什么，把稿子收进文件夹",
      "thought": "写完它就是它自己的事了",
      "feeling": [
        "平静"
      ]
    },
    {
      "id": "e178",
      "at": "2027-01-24T12:30:00.000Z",
      "kind": "想事",
      "text": "阿禾回来，晒黑了，带回一包海鲜干货",
      "thought": "她说话的口音变了一点",
      "feeling": [
        "开心"
      ]
    },
    {
      "id": "e179",
      "at": "2027-01-25T11:50:00.000Z",
      "kind": "想事",
      "text": "想通了，后悔也是选择的一部分",
      "thought": "不后悔的人大概没认真选过",
      "feeling": [
        "明白"
      ],
      "weight": "important"
    },
    {
      "id": "e180",
      "at": "2027-01-25T13:10:00.000Z",
      "kind": "其它",
      "text": "绿萝长出新叶子，我拍了张照发给室友",
      "thought": "原来我真的养活了",
      "feeling": [
        "得意"
      ]
    },
    {
      "id": "e181",
      "at": "2027-01-26T10:20:00.000Z",
      "kind": "其它",
      "text": "给外婆做了葱油面，她说太油",
      "thought": "下次少放油",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e182",
      "at": "2027-01-26T11:40:00.000Z",
      "kind": "其它",
      "text": "开学第一天又去操场走圈",
      "thought": "操场修好了，跑道是新的",
      "feeling": [
        "新鲜"
      ]
    },
    {
      "id": "e183",
      "at": "2027-01-27T12:00:00.000Z",
      "kind": "其它",
      "text": "离家返校，外婆塞了一袋炒花生",
      "thought": "她总觉得我路上会饿",
      "feeling": [
        "舍不得"
      ]
    },
    {
      "id": "e184",
      "at": "2027-01-27T13:20:00.000Z",
      "kind": "发呆",
      "text": "立春后第一只麻雀落在窗台上",
      "thought": "春天是飞来的",
      "feeling": [
        "惊喜"
      ]
    },
    {
      "id": "e185",
      "at": "2027-01-28T11:10:00.000Z",
      "kind": "读书",
      "text": "把《慢船去北方》读完，在扉页写了日期",
