{
  "about": "虚构角色「小舟」一个月里的经历。全部是编的，不来自任何真实角色。用来测：想得起来准不准、没有就说没有、封存和抽屉会不会漏、原文会不会被改。",
  "experiences": [
    {
      "id": "e01",
      "at": "2026-10-01T21:00:00.000Z",
      "kind": "读书",
      "text": "开始读《海上灯塔》，第一章写守灯人搬进塔里的第一个晚上",
      "thought": "一个人住在塔上会不会很冷",
      "feeling": [
        "好奇"
      ]
    },
    {
      "id": "e02",
      "at": "2026-10-02T20:30:00.000Z",
      "kind": "写东西",
      "text": "给自己的博客写了第一篇，讲为什么喜欢看雨",
      "thought": "写出来比想的难",
      "feeling": [
        "紧张"
      ]
    },
    {
      "id": "e03",
      "at": "2026-10-03T19:10:00.000Z",
      "kind": "想事",
      "text": "学着用毛笔写自己的名字，写了二十遍才顺手",
      "thought": "慢慢来反而快",
      "feeling": [
        "专注"
      ]
    },
    {
      "id": "e04",
      "at": "2026-10-04T22:00:00.000Z",
      "kind": "读书",
      "text": "《海上灯塔》第三章，守灯人在暴风雨里修好了透镜",
      "thought": "他其实不怕黑，怕的是船看不见光",
      "feeling": [
        "感动"
      ],
      "unfinished": "想知道那艘迟到的渔船后来有没有回港"
    },
    {
      "id": "e05",
      "at": "2026-10-05T18:00:00.000Z",
      "kind": "发呆",
      "text": "傍晚看窗外的云从橘色变成灰紫色",
      "thought": "颜色变化比我以为的慢",
      "feeling": [
        "安静"
      ]
    },
    {
      "id": "e06",
      "at": "2026-10-06T21:20:00.000Z",
      "kind": "其它",
      "text": "第一次试着做番茄炒蛋，盐放多了",
      "thought": "下次先尝再放",
      "feeling": [
        "好笑"
      ]
    },
    {
      "id": "e07",
      "at": "2026-10-07T20:00:00.000Z",
      "kind": "想事",
      "text": "月考数学没考好，排名掉到后面，晚上一直睡不着",
      "thought": "是不是我根本不适合学这个",
      "feeling": [
        "难过",
        "羞愧"
      ],
      "unfinished": "要不要告诉家里排名的事"
    },
    {
      "id": "e08",
      "at": "2026-10-08T19:30:00.000Z",
      "kind": "读书",
      "text": "查资料才知道灯塔的透镜叫菲涅耳透镜，一圈一圈的棱",
      "thought": "原来光是被折回来的",
      "feeling": [
        "惊喜"
      ],
      "quote": {
        "text": "一盏小灯，借着棱镜，能照到二十海里外",
        "source": "灯塔小百科"
      }
    },
    {
      "id": "e09",
      "at": "2026-10-09T21:40:00.000Z",
      "kind": "写东西",
      "text": "把看雨那篇博客改了三遍，删掉了一半形容词",
      "thought": "删掉的比留下的更重要",
      "feeling": [
        "轻松"
      ]
    },
    {
      "id": "e10",
      "at": "2026-10-10T20:10:00.000Z",
      "kind": "其它",
      "text": "在旧货市场买到一台坏掉的收音机，拆开看了线路",
      "thought": "修不好也想知道它为什么坏",
      "feeling": [
        "兴奋"
      ],
      "unfinished": "收音机还没修好，缺一个电容"
    },
    {
      "id": "e11",
      "at": "2026-10-11T22:30:00.000Z",
      "kind": "想事",
      "text": "和好朋友阿禾因为借书的事吵了一架，谁也没先道歉",
      "thought": "我说话太冲了",
      "feeling": [
        "生气",
        "后悔"
      ]
    },
    {
      "id": "e12",
      "at": "2026-10-12T18:45:00.000Z",
      "kind": "发呆",
      "text": "下雨没带伞，在便利店门口站了二十分钟等雨停",
      "thought": "等雨的时候时间变得很长",
      "feeling": [
        "无聊"
      ]
    },
    {
      "id": "e13",
      "at": "2026-10-13T21:00:00.000Z",
      "kind": "读书",
      "text": "读完《海上灯塔》，结尾守灯人把钥匙交给了年轻的接班人",
      "thought": "离开也是一种守护",
      "feeling": [
        "怅然"
      ]
    },
    {
      "id": "e14",
      "at": "2026-10-14T20:20:00.000Z",
      "kind": "其它",
      "text": "学会了用三根毛线织最简单的辫子花样",
      "thought": "手比脑子记得牢",
      "feeling": [
        "满足"
      ]
    },
    {
      "id": "e15",
      "at": "2026-10-15T19:00:00.000Z",
      "kind": "写东西",
      "text": "投给校刊的小说被退稿了，编辑说结尾太仓促",
      "thought": "也许他说得对，但还是难受",
      "feeling": [
        "沮丧"
      ]
    },
    {
      "id": "e16",
      "at": "2026-10-16T21:10:00.000Z",
      "kind": "想事",
      "text": "夜里想起小时候外婆家门口的那棵桂花树",
      "thought": "气味比画面记得清楚",
      "feeling": [
        "想念"
      ]
    },
    {
      "id": "e17",
      "at": "2026-10-17T20:40:00.000Z",
      "kind": "其它",
      "text": "终于换上了新电容，收音机响了，收到一个放老歌的电台",
      "thought": "原来问题这么小",
      "feeling": [
        "开心"
      ]
    },
    {
      "id": "e18",
      "at": "2026-10-18T18:30:00.000Z",
      "kind": "发呆",
      "text": "坐公交坐过了站，干脆走回家，路过一家没见过的面包店",
      "thought": "迷路有时候是赚到",
      "feeling": [
        "意外"
      ]
    },
    {
      "id": "e19",
      "at": "2026-10-19T22:00:00.000Z",
      "kind": "读书",
      "text": "开始读一本讲深海鱼的科普书，有的鱼自己会发光",
      "thought": "海底也有自己的灯塔",
      "feeling": [
        "着迷"
      ]
    },
    {
      "id": "e20",
      "at": "2026-10-20T20:00:00.000Z",
      "kind": "想事",
      "text": "给阿禾发了消息道歉，她回了一个笑脸",
      "thought": "先开口没有那么难",
      "feeling": [
        "释然"
      ]
    },
    {
      "id": "e21",
      "at": "2026-10-21T19:20:00.000Z",
      "kind": "其它",
      "text": "跟着视频学折纸鹤，折到第五只翅膀才对称",
      "thought": "折痕要压实",
      "feeling": [
        "专注"
      ]
    },
    {
      "id": "e22",
      "at": "2026-10-22T21:30:00.000Z",
      "kind": "写东西",
      "text": "重写了被退稿的那篇小说的结尾，多写了两千字",
      "thought": "仓促是因为我自己也没想清楚",
      "feeling": [
        "踏实"
      ]
    },
    {
      "id": "e23",
      "at": "2026-10-23T18:10:00.000Z",
      "kind": "发呆",
      "text": "在楼顶看了一次日落，太阳掉进两栋楼中间",
      "thought": "城市里的日落也很好看",
      "feeling": [
        "平静"
      ]
    },
    {
      "id": "e24",
      "at": "2026-10-24T20:50:00.000Z",
      "kind": "其它",
      "text": "做番茄炒蛋第二次，这次没放多盐，还加了一点糖",
      "thought": "糖让番茄更甜",
      "feeling": [
        "得意"
      ]
    },
    {
      "id": "e25",
      "at": "2026-10-25T22:15:00.000Z",
      "kind": "想事",
      "text": "体检的时候抽血差点晕倒，护士让我躺了一会儿",
      "thought": "原来我怕针",
      "feeling": [
        "害怕"
      ]
    },
    {
      "id": "e26",
      "at": "2026-10-26T19:40:00.000Z",
      "kind": "读书",
      "text": "深海鱼那本书讲到鮟鱇鱼头上挂着一盏小灯钓猎物",
      "thought": "光既能救人也能骗人",
      "feeling": [
        "惊讶"
      ]
    },
    {
      "id": "e27",
      "at": "2026-10-27T20:30:00.000Z",
      "kind": "回想",
      "text": "回头看这个月，好像每次难过之后都会做点手上的事",
      "thought": "手忙起来心就静了",
      "feeling": [
        "明白"
      ],
      "refs": [
        "e07",
        "e03"
      ]
    },
    {
      "id": "e28",
      "at": "2026-10-28T21:00:00.000Z",
      "kind": "其它",
      "text": "收音机放着老歌的时候，我在旁边织完了一条围巾",
      "thought": "两件喜欢的事叠在一起",
      "feeling": [
        "温暖"
      ]
    },
    {
      "id": "e29",
      "at": "2026-10-29T18:20:00.000Z",
      "kind": "写东西",
      "text": "把改好的小说重新投给校刊，这次没告诉任何人",
      "thought": "结果怎样都可以",
      "feeling": [
        "平静"
      ],
      "unfinished": "等校刊的回信"
    },
    {
      "id": "e30",
      "at": "2026-10-30T22:40:00.000Z",
      "kind": "想事",
      "text": "失眠的晚上数窗外路灯，一共十七盏",
      "thought": "数着数着就困了",
      "feeling": [
        "困"
      ]
    },
    {
      "id": "e31",
      "at": "2026-10-31T21:00:00.000Z",
      "kind": "想事",
      "text": "今天一整天都在想事情。早上醒来的时候外面在下小雨，窗户上都是水珠。中午阿禾来找我，她说最近社团的事情有点多，晚上总是睡不好，还说想退出话剧社。下午我们一起去图书馆还书，路上她提到小时候住在奶奶家，院子里有一口很深的井，夏天会把西瓜放进去冰着。晚上我又想了很久她说的话，觉得她其实很累。",
      "thought": "下次她累的时候，我先听她说完",
      "feeling": [
        "担心"
      ]
    },
    {
      "id": "e32",
      "at": "2026-11-01T20:00:00.000Z",
      "kind": "其它",
      "text": "运动会那天我报了八百米，跑到第二圈的时候小腿抽筋了，只好走完最后半圈。班主任在终点等我，递给我一瓶水，没有说什么。后来同学们在看台上喊我的名字，我有点想哭又有点想笑。回教室的路上看到操场边的银杏叶全黄了，风一吹就往下掉，像下了一场金色的雨。晚上写日记的时候，我写了很久那瓶水。",
      "thought": "没跑完也有人等我",
      "feeling": [
        "委屈",
        "温暖"
      ]
    },
    {
      "id": "e33",
      "at": "2026-11-02T19:00:00.000Z",
      "kind": "其它",
      "text": "周末和爸爸去了海洋博物馆。一进门就是一副巨大的鲸鱼骨架，从天花板上吊下来，爸爸说那是一头蓝鲸，活着的时候有三十米长。我们在水母展区待了很久，灯光是蓝紫色的，水母慢慢地一收一放，像在呼吸。出来的时候买了一张明信片，上面画着灯塔和鲸鱼，打算寄给阿禾。回家的公交车上爸爸睡着了，我看着窗外一直在想，那么大的鲸鱼也会孤单吗。",
      "thought": "大东西也会孤单",
      "feeling": [
        "安静"
      ]
    }
  ],
